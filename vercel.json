{
  "rewrites": [
    {
      "source": "/",
      "destination": "/jimpitan/index.html"
    },
    {
      "source": "/jimpitan/(.*)",
      "destination": "/jimpitan/$1"
    },
    {
      "source": "/inventaris/(.*)",
      "destination": "/inventaris/$1"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}
